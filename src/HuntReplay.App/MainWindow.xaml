<Window x:Class="HuntReplay.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:HuntReplay.App.Views"
        Title="HuntReplay Studio" Width="1380" Height="920" MinWidth="1100" MinHeight="740" WindowStartupLocation="CenterScreen" Background="{StaticResource Background}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" Closing="OnClosing">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#101619" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
      <DockPanel Margin="17,29,17,19">
        <StackPanel DockPanel.Dock="Top">
          <Grid Margin="12,0,0,36"><Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Canvas Width="27" Height="33" VerticalAlignment="Center">
              <Path Data="M13,0 L26,8 26,24 13,32 0,24 0,8 Z" Stroke="{StaticResource Accent}" StrokeThickness="1.3"/>
              <Path Data="M6,9 L6,23 M20,9 L20,23 M6,16 L20,16 M13,5 L13,11 M13,21 L13,27" Stroke="{StaticResource Accent}" StrokeThickness="1.7"/>
            </Canvas>
            <StackPanel Grid.Column="1"><TextBlock Text="HUNTREPLAY" FontSize="15" FontWeight="Bold"/><TextBlock Text="S T U D I O" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
          </Grid>
          <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Style="{StaticResource Eyebrow}" Margin="16,0,0,12"/>
          <RadioButton Style="{StaticResource NavButton}" GroupName="Navigation" IsChecked="{Binding Page, Converter={StaticResource PageSelected}, ConverterParameter=Dashboard}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,13,0"/><TextBlock Text="Обзор" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="Navigation" IsChecked="{Binding Page, Converter={StaticResource PageSelected}, ConverterParameter=Gallery}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,13,0"/><TextBlock Text="Галерея клипов" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="Navigation" IsChecked="{Binding Page, Converter={StaticResource PageSelected}, ConverterParameter=Settings}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,13,0"/><TextBlock Text="Настройки" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
          <RadioButton Style="{StaticResource NavButton}" GroupName="Navigation" IsChecked="{Binding Page, Converter={StaticResource PageSelected}, ConverterParameter=Diagnostics}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,13,0"/><TextBlock Text="Диагностика" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Background="#171F1B" BorderBrush="#2D382B" BorderThickness="1" CornerRadius="7" Padding="15" Margin="0,0,0,20">
            <StackPanel><TextBlock Text="ВАШИ МОМЕНТЫ. ВАША RAM." FontSize="9" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="Без облака, OBS и лишних нажатий. Просто играйте." Style="{StaticResource MutedText}" Margin="0,9,0,0"/></StackPanel>
          </Border>
          <Button Content="Открыть папку клипов  ↗" Style="{StaticResource QuietButton}" Command="{Binding OpenFolderCommand}" HorizontalContentAlignment="Left"/>
          <Border Height="1" Background="{StaticResource Border}" Margin="12,16"/>
          <Grid Margin="12,0"><TextBlock Text="STUDIO  /  0.1.0" FontSize="9" Foreground="{StaticResource Muted}"/><TextBlock Text="LOCAL" FontSize="9" Foreground="{StaticResource Accent}" HorizontalAlignment="Right"/></Grid>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="30,0">
        <Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="FIELD RECORDER  /  HUNT: SHOWDOWN 1896" Style="{StaticResource Eyebrow}" FontSize="9"/><TextBlock Text="{Binding PageTitle}" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,9,0"><TextBlock Text="{Binding PipeLabel}" FontSize="9" Foreground="{StaticResource Muted}"/></Border><Border Background="#222B1C" CornerRadius="4" Padding="10,7"><TextBlock Text="{Binding SetupLabel}" FontSize="9" Foreground="{StaticResource Accent}"/></Border></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="30,26,30,22">
        <views:DashboardView Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Dashboard}"/>
        <views:GalleryView x:Name="Gallery" Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Gallery}"/>
        <views:SettingsView Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Settings}"/>
        <views:DiagnosticsView Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Diagnostics}"/>
      </Grid>
      <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="30,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="{Binding Message}"/><TextBlock Grid.Column="1" Text="WGC  /  WASAPI  /  DIRECT3D 11" Margin="20,0,0,0" FontSize="9" Foreground="#607069" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
  </Grid>
</Window>
