<Window x:Class="HuntReplay.App.Views.SetupWizard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Добро пожаловать в HuntReplay Studio" Width="660" Height="570" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="{StaticResource Background}" Foreground="{StaticResource Text}">
  <Grid Margin="36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="HUNTREPLAY  /  FIRST RUN" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}"/><TextBlock Text="Ваша охота. Уже в записи." FontSize="28" FontWeight="SemiBold" Margin="0,16,0,10"/><TextBlock Text="Инициализация NVIDIA Highlights для Hunt: Showdown и других совместимых игр — на AMD, Intel и NVIDIA." Style="{StaticResource MutedText}"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,24,0,0">
      <Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="01   Подписанная MessageBus.dll" FontWeight="SemiBold"/><TextBlock Text="Встроенный оригинал NVIDIA → C:\NvidiaShim. Установщик сверит SHA-256 и цифровую подпись Windows." Style="{StaticResource MutedText}" Margin="23,7,0,17"/><TextBlock Text="02   Регистрация и резервная копия" FontWeight="SemiBold"/><TextBlock Text="UAC запрашивается только для DLL и четырёх значений HKLM в двух представлениях. Сам рекордер работает без администратора." Style="{StaticResource MutedText}" Margin="23,7,0,0"/></StackPanel></Border>
      <CheckBox x:Name="ReplaceCheck" Content="Разрешить заменить существующую регистрацию NVIDIA (с резервной копией)" FontSize="11" Visibility="Collapsed" Margin="0,14,0,0"/>
      <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="0,17,0,0" Foreground="{StaticResource Warning}"/>
    </StackPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Настроить позже" Style="{StaticResource QuietButton}" Click="LaterClicked" HorizontalAlignment="Left"/><Button x:Name="InstallButton" Grid.Column="1" Content="Установить и продолжить  ↗" Style="{StaticResource PrimaryButton}" Click="InstallClicked"/></Grid>
  </Grid>
</Window>
