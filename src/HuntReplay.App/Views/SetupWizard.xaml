<Window x:Class="HuntReplay.App.Views.SetupWizard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="660" Height="570" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource Background}" Foreground="{DynamicResource Text}">
  <Grid Margin="36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Button Content="{Binding Loc[Header.LanguageToggle]}" Click="LanguageClicked" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" Foreground="{DynamicResource Text}" MinHeight="28" Padding="10,5" Margin="0,-10,0,0" Panel.ZIndex="1" ToolTip="Переключить язык / Toggle language"/>
    <StackPanel><TextBlock Text="{Binding Loc[Wizard.Eyebrow]}" Style="{DynamicResource Eyebrow}" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding Loc[Wizard.Heading]}" FontSize="28" FontWeight="SemiBold" Margin="0,16,0,10"/><TextBlock Text="{Binding Loc[Wizard.Subtitle]}" Style="{DynamicResource MutedText}"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,24,0,0">
      <Border Style="{DynamicResource Card}" Padding="20"><StackPanel><TextBlock Text="{Binding Loc[Wizard.Step1Title]}" FontWeight="SemiBold"/><TextBlock Text="{Binding Loc[Wizard.Step1Desc]}" Style="{DynamicResource MutedText}" Margin="23,7,0,17"/><TextBlock Text="{Binding Loc[Wizard.Step2Title]}" FontWeight="SemiBold"/><TextBlock Text="{Binding Loc[Wizard.Step2Desc]}" Style="{DynamicResource MutedText}" Margin="23,7,0,0"/></StackPanel></Border>
      <CheckBox x:Name="ReplaceCheck" Content="{Binding Loc[Wizard.ReplaceCheck]}" FontSize="11" Visibility="Collapsed" Margin="0,14,0,0"/>
      <TextBlock x:Name="StatusText" Style="{DynamicResource MutedText}" Margin="0,17,0,0" Foreground="{DynamicResource Warning}"/>
    </StackPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="{Binding Loc[Wizard.Later]}" Style="{DynamicResource QuietButton}" Click="LaterClicked" HorizontalAlignment="Left"/><Button x:Name="InstallButton" Grid.Column="1" Content="{Binding Loc[Wizard.Install]}" Style="{DynamicResource PrimaryButton}" Click="InstallClicked"/></Grid>
  </Grid>
</Window>
