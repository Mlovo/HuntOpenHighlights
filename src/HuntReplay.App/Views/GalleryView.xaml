<UserControl x:Class="HuntReplay.App.Views.GalleryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:HuntReplay.App.Controls" xmlns:services="clr-namespace:HuntReplay.App.Services" DataContextChanged="ContextChanged" IsVisibleChanged="VisibilityChanged" Focusable="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    
    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding Loc[Gallery.Title]}" Style="{DynamicResource SectionTitle}"/>
        <TextBlock Text="{Binding LibrarySummary}" Style="{DynamicResource MutedText}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Command="{Binding RefreshCommand}" Margin="0,0,8,0" ToolTip="{Binding Loc[Gallery.RefreshTooltip]}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding Loc[Gallery.Refresh]}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding OpenFolderCommand}" ToolTip="{Binding Loc[Gallery.FolderTooltip]}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding Loc[Gallery.Folder]}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Main Content Area with ScrollViewer -->
    <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
      <StackPanel Margin="0,0,8,0">
        <!-- Player Card -->
        <Border Style="{DynamicResource Card}" Padding="0" Margin="0,0,0,20" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Video Screen -->
            <Border Grid.Row="0" Background="{DynamicResource PlayerBackground}" CornerRadius="9,9,0,0">
              <Grid Height="540" Background="{DynamicResource PlayerBackground}" MouseLeftButtonUp="ScreenClicked" Cursor="Hand">
                <Image x:Name="PlayerImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"/>
                <StackPanel x:Name="PlayerHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.6"/>
                  <TextBlock x:Name="PlayerHintText" Text="{Binding Loc[Gallery.SelectClipHint]}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
              </Grid>
            </Border>
            <!-- Player Controls Row -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,10">
              <Grid>
                <!-- Floating YouTube-style hover preview thumbnail card -->
                <Canvas x:Name="PreviewCanvas" Height="0" VerticalAlignment="Top" ClipToBounds="False" IsHitTestVisible="False">
                  <Border x:Name="PreviewCard" Canvas.Left="0" Canvas.Top="-140" Width="176" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="4" Visibility="Collapsed">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                      <Border CornerRadius="4" ClipToBounds="True" Background="{DynamicResource PlayerPlaceholder}" Height="96">
                        <Image x:Name="PreviewThumb" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Linear"/>
                      </Border>
                      <TextBlock x:Name="PreviewTime" Text="00:00" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,5,0,2"/>
                    </StackPanel>
                  </Border>
                </Canvas>

                <StackPanel>
                  <!-- Player Controls & Timeline -->
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton" Content="▶" Click="PlayPause" Padding="12,5" MinHeight="30" IsEnabled="False"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                      <Button x:Name="VolumeButton" Style="{DynamicResource QuietButton}" Click="VolumeButtonClick" Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip="{Binding Loc[Gallery.Volume]}">
                        <TextBlock x:Name="VolumeIcon" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Button>
                      <Slider x:Name="VolumeSlider" Width="76" Margin="4,0,0,0" Style="{DynamicResource PlayerSlider}" Minimum="0" Maximum="1" Value="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="VolumeChanged" PreviewMouseWheel="VolumeMouseWheel" ToolTip="100%"/>
                    </StackPanel>

                    <!-- Shared Timeline Container -->
                    <Grid Grid.Column="2" Margin="16,0">
                      <Slider x:Name="Seek" Style="{DynamicResource PlayerSlider}" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" IsSnapToTickEnabled="False" IsEnabled="False" PreviewMouseLeftButtonDown="SeekMouseDown" PreviewMouseMove="SeekMouseMove" PreviewMouseLeftButtonUp="SeekMouseUp" MouseMove="SeekHover" MouseLeave="SeekLeave" ValueChanged="SeekChanged"/>
                      <controls:RangeSlider x:Name="TrimSlider" Visibility="Collapsed" MinRange="0.5" RangeDragStarted="OnTrimDragStarted" LiveSeek="OnTrimSliderLiveSeek" RangeDragCompleted="OnTrimDragCompleted" SelectionStartChanged="OnTrimSelectionStartChanged" SelectionEndChanged="OnTrimSelectionEndChanged" PlayheadChanged="OnTrimPlayheadChanged"/>
                    </Grid>

                    <TextBlock x:Name="PositionText" Grid.Column="3" Text="00:00 / 00:00" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>

                    <Button x:Name="TrimButton" ToolTip="{Binding Loc[Gallery.TrimTooltip]}" Grid.Column="4" Margin="12,0,0,0" Click="TrimButtonClick" IsEnabled="False" Padding="10,5" MinHeight="30" FontSize="11">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TrimButtonText" Text="{Binding Loc[Gallery.TrimVideo]}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </Grid>

                  <!-- Inline Collapsible Trim Toolbar -->
                  <Border x:Name="TrimToolbar" Visibility="Collapsed" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                    <StackPanel>
                      <!-- Row 1: Boundary Range Controls (Start & End) -->
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <!-- Left: Start boundary controls -->
                          <ColumnDefinition Width="Auto"/>
                          <!-- Middle spacer -->
                          <ColumnDefinition Width="*"/>
                          <!-- Right: End boundary controls -->
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Group 0: Start Boundary Controls -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock x:Name="TrimStartLabel" Text="{Binding Loc[Gallery.TrimStart]}" Style="{DynamicResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                            <TextBlock x:Name="TrimStartText" Text="00:00" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                          </Border>
                          <Button x:Name="StepStartMinusButton" Content="-0.1s" Click="StepStartMinusClick" ToolTip="-0.1 s" Padding="5,3" MinHeight="26" FontSize="10" Margin="0,0,3,0"/>
                          <Button x:Name="StepStartPlusButton" Content="+0.1s" Click="StepStartPlusClick" ToolTip="+0.1 s" Padding="5,3" MinHeight="26" FontSize="10" Margin="0,0,8,0"/>
                          <Button x:Name="JumpStartButton" Click="JumpStartClick" ToolTip="{Binding Loc[Gallery.JumpStartTooltip]}" Padding="8,3" MinHeight="26" FontSize="11" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                              <TextBlock x:Name="JumpStartText" Text="{Binding Loc[Gallery.JumpStart]}" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                          <Button x:Name="MarkInButton" Click="MarkInClick" ToolTip="{Binding Loc[Gallery.MarkInTooltip]}" Padding="8,3" MinHeight="26" FontSize="11">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                              <TextBlock x:Name="MarkInText" Text="{Binding Loc[Gallery.MarkIn]}" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                        </StackPanel>

                        <!-- Group 2: End Boundary Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button x:Name="MarkOutButton" Click="MarkOutClick" ToolTip="{Binding Loc[Gallery.MarkOutTooltip]}" Padding="8,3" MinHeight="26" FontSize="11" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                              <TextBlock x:Name="MarkOutText" Text="{Binding Loc[Gallery.MarkOut]}" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                          <Button x:Name="JumpEndButton" Click="JumpEndClick" ToolTip="{Binding Loc[Gallery.JumpEndTooltip]}" Padding="8,3" MinHeight="26" FontSize="11" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock x:Name="JumpEndText" Text="{Binding Loc[Gallery.JumpEnd]}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                              <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                          <Button x:Name="StepEndMinusButton" Content="-0.1s" Click="StepEndMinusClick" ToolTip="-0.1 s" Padding="5,3" MinHeight="26" FontSize="10" Margin="0,0,3,0"/>
                          <Button x:Name="StepEndPlusButton" Content="+0.1s" Click="StepEndPlusClick" ToolTip="+0.1 s" Padding="5,3" MinHeight="26" FontSize="10" Margin="0,0,6,0"/>
                          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                            <TextBlock x:Name="TrimEndText" Text="00:00" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                          </Border>
                          <TextBlock x:Name="TrimEndLabel" Text="{Binding Loc[Gallery.TrimEnd]}" Style="{DynamicResource Eyebrow}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Grid>

                      <!-- Row 2: Playback Preview, Duration & Save/Cancel Actions -->
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <!-- Left: Preview & Duration -->
                          <ColumnDefinition Width="Auto"/>
                          <!-- Middle spacer -->
                          <ColumnDefinition Width="*"/>
                          <!-- Right: Save & Cancel -->
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Preview & Duration Badge -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button x:Name="PreviewRangeButton" Click="PreviewRangeClick" ToolTip="{Binding Loc[Gallery.PreviewTooltip]}" Padding="10,4" MinHeight="28" FontSize="11" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock x:Name="PreviewRangeIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                              <TextBlock x:Name="PreviewRangeText" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock x:Name="TrimDurationLabel" Text="{Binding Loc[Gallery.TrimDuration]}" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                              <TextBlock x:Name="TrimDurationText" Text="00:00" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>

                        <!-- Save & Cancel Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button x:Name="SaveFragmentButton" Content="{Binding Loc[Gallery.SaveFragment]}" Style="{DynamicResource PrimaryButton}" Click="SaveFragmentClick" Padding="14,5" MinHeight="28" FontSize="11" Margin="0,0,8,0"/>
                          <Button x:Name="CancelTrimButton" Content="{Binding Loc[Common.Cancel]}" Style="{DynamicResource QuietButton}" Click="CancelTrimClick" Padding="12,5" MinHeight="28" FontSize="11"/>
                        </StackPanel>
                      </Grid>

                      <!-- Export Progress Panel -->
                      <Grid x:Name="TrimProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TrimProgressStatus" Foreground="{DynamicResource Accent}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ProgressBar x:Name="TrimProgressBar" Grid.Column="1" Height="6" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TrimProgressPercent" Grid.Column="2" Text="0%" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="CancelExportButton" Grid.Column="3" Click="CancelExportClick" Padding="10,3" MinHeight="24" FontSize="10"/>
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
            <!-- Clip Actions & Details Bar -->
            <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,12" CornerRadius="0,0,9,9">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                  <Button Content="{Binding Loc[Gallery.Rename]}" Command="{Binding RenameCommand}" CommandParameter="{Binding PreviewClip}" FontSize="11" Padding="12,7" MinHeight="32" Margin="0,0,8,0"/>
                  <Button Content="{Binding Loc[Gallery.Reveal]}" Command="{Binding RevealCommand}" CommandParameter="{Binding PreviewClip}" FontSize="11" Padding="12,7" MinHeight="32" Margin="0,0,8,0"/>
                  <Button Content="{Binding Loc[Gallery.OpenInPlayer]}" Command="{Binding OpenInPlayerCommand}" CommandParameter="{Binding PreviewClip}" FontSize="11" Padding="12,7" MinHeight="32" Margin="0,0,8,0"/>
                  <!-- The player bar acts on the clip in the player; the selection bar below acts on the selection. -->
                  <Button Content="{Binding Loc[Gallery.Delete]}" Command="{Binding DeleteCommand}" CommandParameter="{Binding PreviewClip}" FontSize="11" Padding="12,7" MinHeight="32" Foreground="{DynamicResource Warning}" Style="{DynamicResource QuietButton}"/>
                </StackPanel>
                <!-- The player already says to pick a clip, so the details stay hidden until one is in the player. -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Style.Triggers><DataTrigger Binding="{Binding PreviewClip}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <Grid HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedEventLabel}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding PreviewClip.Detail}" FontSize="11" Foreground="{DynamicResource Accent}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock Text="{Binding PreviewClip.FileName}" Style="{DynamicResource MutedText}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <!-- Search Box -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
        <Border Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Height="38" Width="360">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                  <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="34"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
              <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" MinHeight="0" FontSize="12" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Accent}" AutomationProperties.Name="{Binding Loc[Gallery.SearchName]}"/>
              <TextBlock Text="{Binding Loc[Gallery.SearchPlaceholder]}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </Grid>
        </Border>
        <Grid VerticalAlignment="Center" Margin="16,0,0,0" Visibility="{Binding HasClips, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="{Binding Loc[Gallery.MultiSelectHint]}" Style="{DynamicResource MutedText}" FontSize="11" VerticalAlignment="Center" Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}"/>
          <!-- Selection bar: with 2+ clips selected, clicks only preview, so the selection gets its own actions here. -->
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolVisibility}}">
            <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"><Run Text="{Binding Loc[Gallery.SelectedCount], Mode=OneWay}"/> <Run Text="{Binding SelectedClips.Count, Mode=OneWay}" Foreground="{DynamicResource Accent}"/></TextBlock>
            <Button Content="{Binding Loc[Gallery.DeleteSelected]}" Command="{Binding DeleteCommand}" ToolTip="Del" FontSize="11" Padding="12,7" MinHeight="32" Margin="0,0,8,0" Foreground="{DynamicResource Warning}"/>
            <Button Content="{Binding Loc[Gallery.ClearSelection]}" Click="ClearSelectionClick" ToolTip="Esc" Style="{DynamicResource QuietButton}" FontSize="11" Padding="12,7" MinHeight="32"/>
          </StackPanel>
        </Grid>
        </StackPanel>

        <!-- Clips Grid -->
        <Border Style="{DynamicResource Card}" Visibility="{Binding HasClips, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Loc[Gallery.EmptyTitle]}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Loc[Gallery.EmptyDesc]}" Style="{DynamicResource MutedText}" Margin="0,12,0,0" TextAlignment="Center"/>
          </StackPanel>
        </Border>
        <ListBox x:Name="ClipList" ItemsSource="{Binding FilteredClips}" SelectedItem="{Binding SelectedClip}" SelectionMode="Extended" SelectionChanged="SelectionChanged" PreviewKeyDown="ClipListKeyDown" PreviewMouseWheel="ClipListMouseWheel" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Visibility="{Binding HasClips, Converter={StaticResource BoolVisibility}}" HorizontalContentAlignment="Stretch">
          <!-- Right-click, Shift+F10 or the card's ⋯ open the same menu; a tile already in the selection keeps it, so the menu acts on what is highlighted. -->
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{Binding Loc[Gallery.TrimVideo]}" Command="{Binding TrimCommand}"/>
              <MenuItem Header="{Binding Loc[Gallery.Rename]}" Command="{Binding RenameCommand}" InputGestureText="F2"/>
              <MenuItem Header="{Binding Loc[Gallery.Reveal]}" Command="{Binding RevealCommand}"/>
              <MenuItem Header="{Binding Loc[Gallery.OpenInPlayer]}" Command="{Binding OpenInPlayerCommand}"/>
              <Separator/>
              <MenuItem Header="{Binding Loc[Gallery.Delete]}" Command="{Binding DeleteCommand}" InputGestureText="Del" Foreground="{DynamicResource Warning}"/>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.InputBindings>
            <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
            <KeyBinding Key="F2" Command="{Binding RenameCommand}"/>
          </ListBox.InputBindings>
          <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid x:Name="ClipUniformGrid" Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.Resources>
            <!-- Secondary controls stay out of the way until the card is hovered, focused or selected. -->
            <Style x:Key="CardMoreButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
              <Setter Property="Padding" Value="7,5"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="Opacity" Value="0"/>
              <!-- The implicit TextBlock style sets Segoe UI, so the glyph font goes on the TextBlock itself. -->
              <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontFamily="Segoe MDL2 Assets" FontSize="14" FontWeight="Normal"/></DataTemplate></Setter.Value></Setter>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
              </Style.Triggers>
            </Style>
            <Style x:Key="CardPlayHint" TargetType="Grid">
              <Setter Property="Opacity" Value="0"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
              </Style.Triggers>
            </Style>
            <Style x:Key="CardCheck" TargetType="CheckBox">
              <Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                  <Grid Width="22" Height="22" Background="Transparent">
                    <Ellipse x:Name="Disc" Fill="#990C1013" Stroke="#D9FFFFFF" StrokeThickness="1.5"/>
                    <Path x:Name="Tick" Data="M6.5,11.5 L9.5,14.5 15.5,8.5" Stroke="{DynamicResource PlayerBackground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Disc" Property="Fill" Value="{DynamicResource Accent}"/><Setter TargetName="Disc" Property="Stroke" Value="{DynamicResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value></Setter>
            </Style>
          </ListBox.Resources>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="7,0,7,14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle"><Setter.Value><Style><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Rectangle Margin="-3" RadiusX="11" RadiusY="11" Stroke="{DynamicResource FocusOutline}" StrokeThickness="2"/></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
              <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnClipItemClicked"/>
              <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Tile" Background="{DynamicResource Surface}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="9">
                    <Grid>
                      <ContentPresenter/>
                      <!-- Adds or removes this tile from the selection without Ctrl, so multi-select is discoverable by mouse. -->
                      <CheckBox x:Name="Pick" Style="{StaticResource CardCheck}" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ToolTip="{Binding [Gallery.SelectClip], Source={x:Static services:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Gallery.SelectClip], Source={x:Static services:LocalizationService.Instance}}"/>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource SurfaceRaised}"/><Setter TargetName="Pick" Property="Opacity" Value="1"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Pick" Property="Opacity" Value="1"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pick" Property="Opacity" Value="1"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value></Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <Grid Height="142">
                  <Border Background="{DynamicResource PlayerBackground}" CornerRadius="8,8,0,0"/>
                  <Border CornerRadius="8,8,0,0"><Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/></Border.Background></Border>
                  <!-- Shown on hover only: a click anywhere on the tile previews the clip. -->
                  <Grid Style="{StaticResource CardPlayHint}" Width="36" Height="36" IsHitTestVisible="False">
                    <Ellipse Fill="#B30C1013"/>
                    <Path Data="M14.5,11.5 L25,18 14.5,24.5 Z" Fill="#FFFFFF"/>
                  </Grid>
                  <Border Background="{DynamicResource Accent}" CornerRadius="4" Padding="7,3" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding EventLabel}" Foreground="{DynamicResource PlayerBackground}" FontSize="10" FontWeight="Bold"/>
                  </Border>
                  <Border Background="#B30C1013" CornerRadius="4" Padding="7,3" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding IsPreviewing, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock Text="{Binding [Gallery.NowPlaying], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    </StackPanel>
                  </Border>
                  <Border Background="#B30C1013" CornerRadius="4" Padding="6,3" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Duration}" FontSize="10" FontFamily="Consolas" Foreground="#FFFFFF"/>
                  </Border>
                </Grid>
                <Grid Margin="12,10,6,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="1" Style="{StaticResource CardMoreButton}" Content="&#xE712;" VerticalAlignment="Center" Click="CardMoreClick" ToolTip="{Binding [Gallery.MoreActions], Source={x:Static services:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Gallery.MoreActions], Source={x:Static services:LocalizationService.Instance}}"/>
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
