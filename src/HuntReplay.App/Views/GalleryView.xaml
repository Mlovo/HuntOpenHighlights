<UserControl x:Class="HuntReplay.App.Views.GalleryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:HuntReplay.App.Controls" xmlns:services="clr-namespace:HuntReplay.App.Services" DataContextChanged="ContextChanged" IsVisibleChanged="VisibilityChanged" Focusable="True">
  <UserControl.Resources>
    <!-- Event badge on the cards and under the player; the colour follows ClipViewModel.EventKind. -->
    <Style x:Key="EventBadge" TargetType="Border">
      <Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="8,3"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource EventOther}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding EventKind}" Value="Kill"><Setter Property="Background" Value="{DynamicResource EventKill}"/></DataTrigger>
        <DataTrigger Binding="{Binding EventKind}" Value="Down"><Setter Property="Background" Value="{DynamicResource EventDown}"/></DataTrigger>
        <DataTrigger Binding="{Binding EventKind}" Value="Multi"><Setter Property="Background" Value="{DynamicResource EventMulti}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="EventBadgeText" TargetType="TextBlock">
      <Setter Property="Text" Value="{Binding EventLabel}"/><Setter Property="Foreground" Value="{DynamicResource EventText}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- Square icon button used across the player and the cards. Glyphs set their own font, the implicit TextBlock style sets Segoe UI. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/></Trigger>
      </Style.Triggers>
    </Style>
    <!-- Outline star, filled in the accent colour once the clip is a favorite. DataContext is the clip. -->
    <Style x:Key="FavoriteStar" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="ToolTip" Value="{Binding [Gallery.AddFavorite], Source={x:Static services:LocalizationService.Instance}}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding [Gallery.AddFavorite], Source={x:Static services:LocalizationService.Instance}}"/>
      <Setter Property="Content" Value="&#xE734;"/>
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontFamily="Segoe MDL2 Assets" FontSize="16" FontWeight="Normal" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/></DataTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
          <Setter Property="Content" Value="&#xE735;"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/>
          <Setter Property="ToolTip" Value="{Binding [Gallery.RemoveFavorite], Source={x:Static services:LocalizationService.Instance}}"/>
          <Setter Property="AutomationProperties.Name" Value="{Binding [Gallery.RemoveFavorite], Source={x:Static services:LocalizationService.Instance}}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="GlyphButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontFamily="Segoe MDL2 Assets" FontSize="15" FontWeight="Normal" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/></DataTemplate></Setter.Value></Setter>
    </Style>
    <!-- Filter chips and the view toggle. -->
    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Padding" Value="11,0"/><Setter Property="Height" Value="34"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <ControlTemplate.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/><Setter Property="FontSize" Value="12"/></Style></ControlTemplate.Resources>
        <Border x:Name="Chrome" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceRaised}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource NavSelectedBackground}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ChipCount" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Margin" Value="7,0,0,0"/><Setter Property="FontSize" Value="11"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="ViewToggle" TargetType="RadioButton" BasedOn="{StaticResource Chip}">
      <Setter Property="Width" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/></DataTemplate></Setter.Value></Setter>
    </Style>
    <!-- Keyboard key caps in the selection bar hints. -->
    <Style x:Key="KeyCap" TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="6,2"/><Setter Property="Margin" Value="6,0,18,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="KeyCapText" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
    <!-- Square selection box on the list cards. -->
    <Style x:Key="SquareCheck" TargetType="CheckBox">
      <Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="IsChecked" Value="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"/>
      <Setter Property="ToolTip" Value="{Binding [Gallery.SelectClip], Source={x:Static services:LocalizationService.Instance}}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding [Gallery.SelectClip], Source={x:Static services:LocalizationService.Instance}}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="28" Height="28" Background="Transparent">
            <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" BorderThickness="1.5" BorderBrush="{DynamicResource CheckBoxBorder}" Background="{DynamicResource ControlBackground}"/>
            <Path x:Name="Tick" Data="M8.5,14 L12,17.5 19.5,10" Stroke="{DynamicResource CheckMarkForeground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <!-- Round selection mark overlaid on the grid tiles. -->
    <Style x:Key="CardCheck" TargetType="CheckBox" BasedOn="{StaticResource SquareCheck}">
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="22" Height="22" Background="Transparent">
            <Ellipse x:Name="Disc" Fill="#990C1013" Stroke="#D9FFFFFF" StrokeThickness="1.5"/>
            <Path x:Name="Tick" Data="M6.5,11.5 L9.5,14.5 15.5,8.5" Stroke="{DynamicResource PlayerBackground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Disc" Property="Fill" Value="{DynamicResource Accent}"/><Setter TargetName="Disc" Property="Stroke" Value="{DynamicResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <ItemsPanelTemplate x:Key="ListPanel"><VirtualizingStackPanel/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="GridPanel"><UniformGrid Columns="2"/></ItemsPanelTemplate>

    <!-- List view: compact horizontal cards. -->
    <DataTemplate x:Key="ListCard">
      <Grid Height="68">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <CheckBox Style="{StaticResource SquareCheck}" Margin="0,0,8,0"/>
        <Grid Grid.Column="1" Width="120" Height="68">
          <Border Background="{DynamicResource PlayerBackground}" CornerRadius="6"/>
          <Border CornerRadius="6"><Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/></Border.Background></Border>
          <Border Background="#B30C1013" CornerRadius="4" Padding="5,2" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding Duration}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"/>
          </Border>
          <!-- The clip in the player. -->
          <Grid Width="26" Height="26" IsHitTestVisible="False" Visibility="{Binding IsPreviewing, Converter={StaticResource BoolVisibility}}">
            <Ellipse Fill="#B30C1013"/>
            <Path Data="M10.5,8 L18.5,13 10.5,18 Z" Fill="{DynamicResource Accent}"/>
          </Grid>
        </Grid>
        <StackPanel Grid.Column="2" Margin="14,0,8,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource EventBadge}"><TextBlock Style="{StaticResource EventBadgeText}"/></Border>
          </StackPanel>
          <TextBlock Text="{Binding CustomName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding FileName}">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding CustomName}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MaxHeight="34" Margin="0,6,0,0" ToolTip="{Binding FileName}"/>
        </StackPanel>
        <Button Grid.Column="3" Style="{StaticResource FavoriteStar}" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Focusable="False"/>
        <Button Grid.Column="4" Style="{StaticResource GlyphButton}" Content="&#xE712;" Foreground="{DynamicResource Muted}" Focusable="False" Click="CardMoreClick" ToolTip="{Binding [Gallery.MoreActions], Source={x:Static services:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Gallery.MoreActions], Source={x:Static services:LocalizationService.Instance}}"/>
      </Grid>
    </DataTemplate>

    <!-- Grid view: thumbnail tiles. -->
    <DataTemplate x:Key="GridTile">
      <StackPanel>
        <Grid Height="128">
          <Border Background="{DynamicResource PlayerBackground}" CornerRadius="7,7,0,0"/>
          <Border CornerRadius="7,7,0,0"><Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/></Border.Background></Border>
          <Border Style="{StaticResource EventBadge}" Margin="9" VerticalAlignment="Bottom"><TextBlock Style="{StaticResource EventBadgeText}"/></Border>
          <Border Background="#B30C1013" CornerRadius="4" Padding="6,3" Margin="9" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding IsPreviewing, Converter={StaticResource BoolVisibility}}">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock Text="{Binding [Gallery.NowPlaying], Source={x:Static services:LocalizationService.Instance}}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"/>
            </StackPanel>
          </Border>
          <Border Background="#B30C1013" CornerRadius="4" Padding="6,3" Margin="9" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding Duration}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"/>
          </Border>
          <CheckBox Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top">
            <CheckBox.Style>
              <Style TargetType="CheckBox" BasedOn="{StaticResource CardCheck}">
                <Setter Property="Opacity" Value="0"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
                  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
                  <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </CheckBox.Style>
          </CheckBox>
        </Grid>
        <Grid Margin="11,8,4,9">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource FavoriteStar}" Width="30" Height="30" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Focusable="False"/>
          <Button Grid.Column="2" Style="{StaticResource GlyphButton}" Width="30" Height="30" Content="&#xE712;" Foreground="{DynamicResource Muted}" Focusable="False" Click="CardMoreClick" ToolTip="{Binding [Gallery.MoreActions], Source={x:Static services:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Gallery.MoreActions], Source={x:Static services:LocalizationService.Instance}}"/>
        </Grid>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Loc[Gallery.Title]}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding LibrarySummary}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="14,0" MinHeight="36" ToolTip="{Binding Loc[Gallery.RefreshTooltip]}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Loc[Gallery.Refresh]}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding OpenFolderCommand}" Padding="14,0" MinHeight="36" ToolTip="{Binding Loc[Gallery.FolderTooltip]}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Loc[Gallery.Folder]}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Stacked when narrow; ApplyLayout moves the library beside the player when the view is wide enough. -->
    <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
      <Grid x:Name="BodyGrid" Margin="0,0,8,0">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="PlayerColumn" Width="*"/><ColumnDefinition x:Name="SplitterColumn" Width="0"/><ColumnDefinition x:Name="LibraryColumn" Width="0"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition x:Name="BodyTopRow" Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <!-- Side by side only: dragging it trades width between the player and the clip list; arrow keys work once it has focus. -->
        <GridSplitter x:Name="LibrarySplitter" Grid.Column="1" DragCompleted="SplitterDragCompleted" Visibility="Collapsed" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" KeyboardIncrement="20" Cursor="SizeWE" ToolTip="{Binding Loc[Gallery.ResizeLibrary]}" AutomationProperties.Name="{Binding Loc[Gallery.ResizeLibrary]}">
          <GridSplitter.Template>
            <ControlTemplate TargetType="GridSplitter">
              <Grid Background="Transparent"><Border x:Name="Grip" Width="2" Height="48" CornerRadius="1" Background="{DynamicResource Border}" VerticalAlignment="Center"/></Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </GridSplitter.Template>
        </GridSplitter>

        <!-- Player Card -->
        <Border x:Name="PlayerCard" Grid.ColumnSpan="3" Style="{DynamicResource Card}" Padding="0" Margin="0,0,0,20" ClipToBounds="True" VerticalAlignment="Top">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition x:Name="PlayerScreenRow" Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Video Screen -->
            <Border Grid.Row="0" Background="{DynamicResource PlayerBackground}" CornerRadius="9,9,0,0">
              <Grid x:Name="PlayerScreen" Height="540" Background="{DynamicResource PlayerBackground}" MouseLeftButtonUp="ScreenClicked" Cursor="Hand">
                <Image x:Name="PlayerImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"/>
                <StackPanel x:Name="PlayerHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.6"/>
                  <TextBlock x:Name="PlayerHintText" Text="{Binding Loc[Gallery.SelectClipHint]}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
              </Grid>
            </Border>
            <!-- Player Controls Row -->
            <Border Grid.Row="1" Background="{DynamicResource Surface}" Padding="14,8,14,10">
              <Grid>
                <!-- Floating YouTube-style hover preview thumbnail card -->
                <Canvas x:Name="PreviewCanvas" Height="0" VerticalAlignment="Top" ClipToBounds="False" IsHitTestVisible="False">
                  <Border x:Name="PreviewCard" Canvas.Left="0" Canvas.Top="-130" Width="176" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="4" Visibility="Collapsed">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                      <Border CornerRadius="4" ClipToBounds="True" Background="{DynamicResource PlayerPlaceholder}" Height="96">
                        <Image x:Name="PreviewThumb" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Linear"/>
                      </Border>
                      <TextBlock x:Name="PreviewTime" Text="00:00" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,5,0,2"/>
                    </StackPanel>
                  </Border>
                </Canvas>

                <StackPanel>
                  <!-- Shared Timeline Container -->
                  <Grid Margin="0,0,0,4">
                    <Slider x:Name="Seek" Style="{DynamicResource PlayerSlider}" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" IsSnapToTickEnabled="False" IsEnabled="False" PreviewMouseLeftButtonDown="SeekMouseDown" PreviewMouseMove="SeekMouseMove" PreviewMouseLeftButtonUp="SeekMouseUp" MouseMove="SeekHover" MouseLeave="SeekLeave" ValueChanged="SeekChanged"/>
                    <controls:RangeSlider x:Name="TrimSlider" Visibility="Collapsed" MinRange="0.5" RangeDragStarted="OnTrimDragStarted" LiveSeek="OnTrimSliderLiveSeek" RangeDragCompleted="OnTrimDragCompleted" SelectionStartChanged="OnTrimSelectionStartChanged" SelectionEndChanged="OnTrimSelectionEndChanged" PlayheadChanged="OnTrimPlayheadChanged"/>
                  </Grid>
                  <!-- Player Controls -->
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="▶" Click="PlayPause" IsEnabled="False">
                      <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="16" FontWeight="Normal" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/></DataTemplate></Button.ContentTemplate>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                      <!-- A circular arrow with "10" inside; mirrored for the step back. -->
                      <Button x:Name="BackButton" Style="{StaticResource IconButton}" Click="BackClick" IsEnabled="False" ToolTip="{Binding Loc[Gallery.Back10]}" AutomationProperties.Name="{Binding Loc[Gallery.Back10]}">
                        <Grid>
                          <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="20" FontWeight="Normal" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><ScaleTransform ScaleX="-1"/></TextBlock.RenderTransform></TextBlock>
                          <TextBlock Text="10" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                      </Button>
                      <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Click="ForwardClick" IsEnabled="False" ToolTip="{Binding Loc[Gallery.Forward10]}" AutomationProperties.Name="{Binding Loc[Gallery.Forward10]}">
                        <Grid>
                          <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="20" FontWeight="Normal"/>
                          <TextBlock Text="10" FontSize="7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                      </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                      <Border Width="1" Height="20" Background="{DynamicResource Border}" Margin="0,0,10,0"/>
                      <Button x:Name="VolumeButton" Style="{StaticResource IconButton}" Click="VolumeButtonClick" ToolTip="{Binding Loc[Gallery.Volume]}">
                        <TextBlock x:Name="VolumeIcon" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="15" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Button>
                      <Slider x:Name="VolumeSlider" Width="84" Margin="4,0,0,0" Style="{DynamicResource PlayerSlider}" Minimum="0" Maximum="1" Value="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="VolumeChanged" PreviewMouseWheel="VolumeMouseWheel" ToolTip="100%"/>
                    </StackPanel>

                    <TextBlock x:Name="PositionText" Grid.Column="4" Text="00:00 / 00:00" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,6,0"/>

                    <Button x:Name="TrimButton" ToolTip="{Binding Loc[Gallery.TrimTooltip]}" Grid.Column="5" Margin="8,0,0,0" Click="TrimButtonClick" IsEnabled="False" Padding="12,0" MinHeight="34">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="TrimButtonText" Text="{Binding Loc[Gallery.Trim]}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="FullscreenButton" Grid.Column="6" Style="{StaticResource GlyphButton}" Content="&#xE740;" Click="FullscreenClick" IsEnabled="False" Margin="6,0,0,0" ToolTip="{Binding Loc[Gallery.Fullscreen]}" AutomationProperties.Name="{Binding Loc[Gallery.Fullscreen]}"/>
                  </Grid>

                  <!-- Inline Collapsible Trim Toolbar -->
                  <Border x:Name="TrimToolbar" Visibility="Collapsed" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                    <StackPanel>
                      <!-- Row 1: Boundary Range Controls (Start & End) -->
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                          <!-- Left: Start boundary controls -->
                          <ColumnDefinition Width="Auto"/>
                          <!-- Middle spacer -->
                          <ColumnDefinition Width="*"/>
                          <!-- Right: End boundary controls -->
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <!-- Group 0: Start Boundary Controls -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock x:Name="TrimStartLabel" Text="{Binding Loc[Gallery.TrimStart]}" Style="{DynamicResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                            <TextBlock x:Name="TrimStartText" Text="00:00" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                          </Border>
                          <Button x:Name="StepStartMinusButton" Content="-0.1s" Click="StepStartMinusClick" ToolTip="-0.1 s" Padding="5,3" MinHeight="26" FontSize="10" Margin="0,0,3,0"/>
                          <Button x:Name="StepStartPlusButton" Content="+0.1s" Click="StepStartPlusClick" ToolTip="+0.1 s" Padding="5,3" MinHeight="26" FontSize="10" Margin="0,0,8,0"/>
                          <Button x:Name="JumpStartButton" Click="JumpStartClick" ToolTip="{Binding Loc[Gallery.JumpStartTooltip]}" Padding="8,3" MinHeight="26" FontSize="11" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                              <TextBlock x:Name="JumpStartText" Text="{Binding Loc[Gallery.JumpStart]}" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                          <Button x:Name="MarkInButton" Click="MarkInClick" ToolTip="{Binding Loc[Gallery.MarkInTooltip]}" Padding="8,3" MinHeight="26" FontSize="11">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                              <TextBlock x:Name="MarkInText" Text="{Binding Loc[Gallery.MarkIn]}" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                        </StackPanel>

                        <!-- Group 2: End Boundary Controls -->
                        <StackPanel x:Name="TrimEndControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button x:Name="MarkOutButton" Click="MarkOutClick" ToolTip="{Binding Loc[Gallery.MarkOutTooltip]}" Padding="8,3" MinHeight="26" FontSize="11" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                              <TextBlock x:Name="MarkOutText" Text="{Binding Loc[Gallery.MarkOut]}" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                          <Button x:Name="JumpEndButton" Click="JumpEndClick" ToolTip="{Binding Loc[Gallery.JumpEndTooltip]}" Padding="8,3" MinHeight="26" FontSize="11" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock x:Name="JumpEndText" Text="{Binding Loc[Gallery.JumpEnd]}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                              <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                          <Button x:Name="StepEndMinusButton" Content="-0.1s" Click="StepEndMinusClick" ToolTip="-0.1 s" Padding="5,3" MinHeight="26" FontSize="10" Margin="0,0,3,0"/>
                          <Button x:Name="StepEndPlusButton" Content="+0.1s" Click="StepEndPlusClick" ToolTip="+0.1 s" Padding="5,3" MinHeight="26" FontSize="10" Margin="0,0,6,0"/>
                          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                            <TextBlock x:Name="TrimEndText" Text="00:00" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                          </Border>
                          <TextBlock x:Name="TrimEndLabel" Text="{Binding Loc[Gallery.TrimEnd]}" Style="{DynamicResource Eyebrow}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Grid>

                      <!-- Row 2: Playback Preview, Duration & Save/Cancel Actions -->
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <!-- Left: Preview & Duration -->
                          <ColumnDefinition Width="Auto"/>
                          <!-- Middle spacer -->
                          <ColumnDefinition Width="*"/>
                          <!-- Right: Save & Cancel -->
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Preview & Duration Badge -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button x:Name="PreviewRangeButton" Click="PreviewRangeClick" ToolTip="{Binding Loc[Gallery.PreviewTooltip]}" Padding="10,4" MinHeight="28" FontSize="11" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock x:Name="PreviewRangeIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                              <TextBlock x:Name="PreviewRangeText" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock x:Name="TrimDurationLabel" Text="{Binding Loc[Gallery.TrimDuration]}" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                              <TextBlock x:Name="TrimDurationText" Text="00:00" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>

                        <!-- Save & Cancel Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button x:Name="SaveFragmentButton" Content="{Binding Loc[Gallery.SaveFragment]}" Style="{DynamicResource PrimaryButton}" Click="SaveFragmentClick" Padding="14,5" MinHeight="28" FontSize="11" Margin="0,0,8,0"/>
                          <Button x:Name="CancelTrimButton" Content="{Binding Loc[Common.Cancel]}" Style="{DynamicResource QuietButton}" Click="CancelTrimClick" Padding="12,5" MinHeight="28" FontSize="11"/>
                        </StackPanel>
                      </Grid>

                      <!-- Export Progress Panel -->
                      <Grid x:Name="TrimProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TrimProgressStatus" Foreground="{DynamicResource Accent}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ProgressBar x:Name="TrimProgressBar" Grid.Column="1" Height="6" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TrimProgressPercent" Grid.Column="2" Text="0%" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="CancelExportButton" Grid.Column="3" Click="CancelExportClick" Padding="10,3" MinHeight="24" FontSize="10"/>
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
            <!-- Details of the clip in the player. Hidden, not collapsed, so loading a clip does not shift the layout. -->
            <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,12" CornerRadius="0,0,9,9">
              <Grid x:Name="ClipDetails" DataContext="{Binding PreviewClip}">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers>
                  </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource EventBadge}" Padding="10,4"><TextBlock Style="{StaticResource EventBadgeText}" FontSize="13"/></Border>
                    <TextBlock Text="{Binding CustomName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"><Run Text="{Binding Meta, Mode=OneWay}"/><Run x:Name="VideoFormatRun"/></TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource FavoriteStar}" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" BorderBrush="{DynamicResource Border}" Width="38" Height="38" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Style="{StaticResource GlyphButton}" Content="&#xE712;" BorderBrush="{DynamicResource Border}" Width="38" Height="38" Click="PlayerMoreClick" ToolTip="{Binding [Gallery.MoreActions], Source={x:Static services:LocalizationService.Instance}}" AutomationProperties.Name="{Binding [Gallery.MoreActions], Source={x:Static services:LocalizationService.Instance}}">
                  <Button.ContextMenu>
                    <!-- Acts on the clip in the player; DataContext is set to the view model when it opens. -->
                    <ContextMenu x:Name="PlayerMenu">
                      <MenuItem Header="{Binding Loc[Gallery.TrimVideo]}" Command="{Binding TrimCommand}" CommandParameter="{Binding PreviewClip}"/>
                      <MenuItem Header="{Binding Loc[Gallery.Rename]}" Command="{Binding RenameCommand}" CommandParameter="{Binding PreviewClip}"/>
                      <MenuItem Header="{Binding Loc[Gallery.Reveal]}" Command="{Binding RevealCommand}" CommandParameter="{Binding PreviewClip}"/>
                      <MenuItem Header="{Binding Loc[Gallery.OpenInPlayer]}" Command="{Binding OpenInPlayerCommand}" CommandParameter="{Binding PreviewClip}"/>
                      <Separator/>
                      <MenuItem Header="{Binding Loc[Gallery.Delete]}" Command="{Binding DeleteCommand}" CommandParameter="{Binding PreviewClip}" Foreground="{DynamicResource EventDown}"/>
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Grid x:Name="LibraryPanel" Grid.Row="1" Grid.ColumnSpan="3">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <!-- Search Box -->
          <Border x:Name="SearchField" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Height="40">
            <Border.Style>
              <Style TargetType="Border">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Muted}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" MinHeight="0" FontSize="13" Foreground="{DynamicResource Text}" CaretBrush="{DynamicResource Accent}" AutomationProperties.Name="{Binding Loc[Gallery.SearchName]}"/>
                <TextBlock Text="{Binding Loc[Gallery.SearchPlaceholder]}" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Grid>
          </Border>

          <!-- Event and favorites filters and the view toggle. The chips wrap when the column is narrow. -->
          <DockPanel Grid.Row="1" Margin="0,12,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <RadioButton x:Name="ListViewToggle" Style="{StaticResource ViewToggle}" GroupName="ClipView" Content="&#xE8FD;" IsChecked="True" Checked="ViewModeChecked" ToolTip="{Binding Loc[Gallery.ViewList]}" AutomationProperties.Name="{Binding Loc[Gallery.ViewList]}"/>
              <RadioButton x:Name="GridViewToggle" Style="{StaticResource ViewToggle}" GroupName="ClipView" Content="&#xE80A;" Checked="ViewModeChecked" ToolTip="{Binding Loc[Gallery.ViewGrid]}" AutomationProperties.Name="{Binding Loc[Gallery.ViewGrid]}"/>
            </StackPanel>
            <WrapPanel>
              <RadioButton Style="{StaticResource Chip}" GroupName="EventFilter" IsChecked="{Binding EventFilter, Converter={StaticResource PageSelected}, ConverterParameter=All}">
                <TextBlock Text="{Binding Loc[Gallery.FilterAll]}"/>
              </RadioButton>
              <RadioButton Style="{StaticResource Chip}" GroupName="EventFilter" IsChecked="{Binding EventFilter, Converter={StaticResource PageSelected}, ConverterParameter=Kill}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Loc[Gallery.FilterKills]}"/><TextBlock Text="{Binding KillCount}" Style="{StaticResource ChipCount}"/></StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource Chip}" GroupName="EventFilter" IsChecked="{Binding EventFilter, Converter={StaticResource PageSelected}, ConverterParameter=Down}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Loc[Gallery.FilterDowns]}"/><TextBlock Text="{Binding DownCount}" Style="{StaticResource ChipCount}"/></StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource Chip}" GroupName="EventFilter" IsChecked="{Binding EventFilter, Converter={StaticResource PageSelected}, ConverterParameter=Multi}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Loc[Gallery.FilterMulti]}"/><TextBlock Text="{Binding MultiCount}" Style="{StaticResource ChipCount}"/></StackPanel>
              </RadioButton>
              <!-- Shown once something is starred; independent of the event chips, so it combines with them. -->
              <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding FavoritesOnly}" Visibility="{Binding ShowFavoritesFilter, Converter={StaticResource BoolVisibility}}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding Loc[Gallery.FilterFavorites]}"/><TextBlock Text="{Binding FavoriteCount}" Style="{StaticResource ChipCount}"/></StackPanel>
              </ToggleButton>
            </WrapPanel>
          </DockPanel>

          <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="6">
            <Grid>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,40" Visibility="{Binding HasClips, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}">
                <TextBlock Text="{Binding Loc[Gallery.EmptyTitle]}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Loc[Gallery.EmptyDesc]}" Style="{DynamicResource MutedText}" Margin="0,10,0,0" TextAlignment="Center"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,40" Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding FilteredEmptyTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding FilteredEmptyDesc}" Style="{DynamicResource MutedText}" Margin="0,8,0,0" TextAlignment="Center"/>
              </StackPanel>
              <ListBox x:Name="ClipList" ItemsSource="{Binding FilteredClips}" SelectedItem="{Binding SelectedClip}" SelectionMode="Extended" SelectionChanged="SelectionChanged" PreviewKeyDown="ClipListKeyDown" PreviewMouseWheel="ClipListMouseWheel" ContextMenuOpening="ClipListContextMenuOpening"
                       ItemTemplate="{StaticResource ListCard}" ItemsPanel="{StaticResource ListPanel}" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True"
                       Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Visibility="{Binding HasClips, Converter={StaticResource BoolVisibility}}" HorizontalContentAlignment="Stretch">
                <!-- Right-click, Shift+F10 or a card's ⋯ open the same menu. On a clip in the selection it acts on the whole selection; on any other clip it acts on that clip alone (Tag). -->
                <ListBox.ContextMenu>
                  <ContextMenu x:Name="ClipMenu">
                    <MenuItem Header="{Binding Loc[Gallery.TrimVideo]}" Command="{Binding TrimCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="{Binding Loc[Gallery.Rename]}" Command="{Binding RenameCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="F2"/>
                    <MenuItem Header="{Binding Loc[Gallery.Reveal]}" Command="{Binding RevealCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="{Binding Loc[Gallery.OpenInPlayer]}" Command="{Binding OpenInPlayerCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Separator/>
                    <MenuItem Header="{Binding Loc[Gallery.Delete]}" Command="{Binding DeleteCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Del" Foreground="{DynamicResource EventDown}"/>
                  </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.InputBindings>
                  <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
                  <KeyBinding Key="F2" Command="{Binding RenameCommand}"/>
                </ListBox.InputBindings>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,0,0,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
                    <Setter Property="FocusVisualStyle"><Setter.Value><Style><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Rectangle Margin="-1" RadiusX="9" RadiusY="9" Stroke="{DynamicResource FocusOutline}" StrokeThickness="1.5"/></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnClipItemClicked"/>
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnClipItemRightClicked"/>
                    <Setter Property="Template"><Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tile" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}" ClipToBounds="True">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource SurfaceRaised}"/></Trigger>
                          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource ListItemHighlight}"/></Trigger>
                          <!-- The clip in the player gets the accent outline, independent of the selection. -->
                          <DataTrigger Binding="{Binding IsPreviewing}" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/></DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value></Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>

    <!-- Selection bar: what is ticked, and what can be done with it. Clicks on cards only change the player. -->
    <Border Grid.Row="2" Margin="0,14,0,0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="10,8" MinHeight="56" Visibility="{Binding HasClips, Converter={StaticResource BoolVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Loc[Gallery.MultiSelectHint]}" Style="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="6,0,16,0" TextWrapping="NoWrap" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}"/>
        <StackPanel Orientation="Horizontal" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
          <Button Click="ClearSelectionClick" Style="{StaticResource IconButton}" Background="{DynamicResource Accent}" Width="34" Height="34" ToolTip="{Binding Loc[Gallery.ClearSelection]}" AutomationProperties.Name="{Binding Loc[Gallery.ClearSelection]}">
            <Path Data="M4,9 L8,13 15,5" Stroke="{DynamicResource CheckMarkForeground}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="19" Height="18"/>
          </Button>
          <TextBlock Text="{Binding SelectionSummary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,18,0"/>
          <Button Click="PlaySelectedClick" Padding="14,0" MinHeight="36" Margin="0,0,8,0" Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{Binding Loc[Gallery.PlaySelected]}" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button Click="RevealSelectedClick" Padding="14,0" MinHeight="36" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{Binding Loc[Gallery.OpenInFolder]}" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button Command="{Binding DeleteCommand}" ToolTip="Del" Padding="14,0" MinHeight="36" Foreground="{DynamicResource EventDown}" BorderBrush="{DynamicResource DangerBorder}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{Binding Loc[Gallery.Delete]}" VerticalAlignment="Center"/></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel x:Name="SelectionHints" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="{Binding Loc[Gallery.HintSelectAll]}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
          <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyCapText}" Text="Ctrl + A"/></Border>
          <TextBlock Text="{Binding Loc[Gallery.HintRange]}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
          <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyCapText}"><Run Text="Shift + "/><Run Text="{Binding Loc[Gallery.KeyClick], Mode=OneWay}"/></TextBlock></Border>
          <TextBlock Text="{Binding Loc[Gallery.HintAdd]}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
          <Border Style="{StaticResource KeyCap}" Margin="6,0,4,0"><TextBlock Style="{StaticResource KeyCapText}"><Run Text="Ctrl + "/><Run Text="{Binding Loc[Gallery.KeyClick], Mode=OneWay}"/></TextBlock></Border>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
