<UserControl x:Class="HuntReplay.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Loc[Settings.Notice]}" Style="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="0,0,20,0"/><Button Grid.Column="1" Content="{Binding Loc[Settings.Save]}" Command="{Binding ApplySettingsCommand}" Style="{DynamicResource PrimaryButton}"/></Grid></Border>
    <TabControl x:Name="SettingsTabControl" SelectionChanged="OnTabSelectionChanged">
      <TabItem Header="{Binding Loc[Settings.TabVideo]}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
        <TextBlock Text="{Binding Loc[Video.Title]}" Style="{DynamicResource SectionTitle}"/><TextBlock Text="{Binding Loc[Video.Subtitle]}" Style="{DynamicResource MutedText}" Margin="0,0,0,22"/>
        <Border Style="{DynamicResource Card}"><StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Loc[Video.Source]}" Margin="0,0,0,9"/><ComboBox ItemsSource="{Binding Sources}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SettingsEdit.Video.Source}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding Loc[Video.Monitor]}" Margin="0,0,0,9"/><ComboBox ItemsSource="{Binding MonitorSelection.Options}" DisplayMemberPath="Name" SelectedValuePath="Id" IsSynchronizedWithCurrentItem="False" SelectedValue="{Binding MonitorSelection.SelectedId, Mode=TwoWay}"/></StackPanel></Grid>
          <TextBlock Text="{Binding Loc[Video.SourceHint]}" Style="{DynamicResource MutedText}" Margin="0,12,0,24"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Loc[Video.Resolution]}" Margin="0,0,0,9"/><ComboBox ItemsSource="{Binding Resolutions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SettingsEdit.Video.Resolution}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding Loc[Video.Fps]}" Margin="0,0,0,9"/><ComboBox ItemsSource="{Binding FrameRates}" SelectedItem="{Binding SettingsEdit.Video.Fps}"/></StackPanel></Grid>
          <Border Height="1" Background="{DynamicResource Border}" Margin="0,24"/>
          <TextBlock Text="{Binding Loc[Video.Gpu]}" Margin="0,0,0,9"/>
          <ComboBox ItemsSource="{Binding GpuSelection.Options}" DisplayMemberPath="Name" SelectedValuePath="Id" IsSynchronizedWithCurrentItem="False" SelectedValue="{Binding GpuSelection.SelectedId, Mode=TwoWay}"/>
          <TextBlock Text="{Binding Loc[Video.GpuHint]}" Style="{DynamicResource MutedText}" Margin="0,12,0,24"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Loc[Video.Encoder]}" Margin="0,0,0,9"/><ComboBox ItemsSource="{Binding Encoders}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SettingsEdit.Video.Encoder}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding Loc[Video.Codec]}" Margin="0,0,0,9"/><ComboBox ItemsSource="{Binding Codecs}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SettingsEdit.Video.Codec}"/></StackPanel></Grid>
          <TextBlock Text="{Binding Loc[Video.EncoderHint]}" Style="{DynamicResource MutedText}" Margin="0,12,0,22"/>
          <Grid><TextBlock Text="{Binding Loc[Video.Bitrate]}"/><TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Accent}"><Run Text="{Binding Value, ElementName=Bitrate, StringFormat={}{0:F0}, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Loc[Unit.Mbps], Mode=OneWay}"/></TextBlock></Grid>
          <Slider x:Name="Bitrate" Minimum="10" Maximum="80" Value="{Binding SettingsEdit.Video.BitrateMbps}"/>
          <Grid Margin="0,0,0,24"><TextBlock FontSize="10" Foreground="{DynamicResource Muted}"><Run Text="10 "/><Run Text="{Binding Loc[Unit.Mbps], Mode=OneWay}"/></TextBlock><TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource Muted}"><Run Text="80 "/><Run Text="{Binding Loc[Unit.Mbps], Mode=OneWay}"/></TextBlock></Grid>
          <TextBlock Text="{Binding Loc[Video.KeyframeInterval]}" Margin="0,0,0,9"/><ComboBox ItemsSource="{Binding GopLengths}" SelectedItem="{Binding SettingsEdit.Video.GopSeconds}" Width="190" HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding Loc[Video.GopHint]}" Style="{DynamicResource MutedText}" Margin="0,12,0,0"/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{Binding Loc[Settings.TabAudio]}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
        <TextBlock Text="{Binding Loc[Audio.Title]}" Style="{DynamicResource SectionTitle}"/><TextBlock Text="{Binding Loc[Audio.Subtitle]}" Style="{DynamicResource MutedText}" Margin="0,0,0,22"/>
        <Border Style="{DynamicResource Card}"><StackPanel><TextBlock Text="{Binding Loc[Audio.Output]}" Margin="0,0,0,9"/><ComboBox ItemsSource="{Binding OutputSelection.Options}" DisplayMemberPath="Name" SelectedValuePath="Id" IsSynchronizedWithCurrentItem="False" SelectedValue="{Binding OutputSelection.SelectedId, Mode=TwoWay}"/>
          <TextBlock Text="{Binding Loc[Audio.OutputHint]}" Style="{DynamicResource MutedText}" Margin="0,12,0,20"/>
          <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,17"/>
          <CheckBox Content="{Binding Loc[Audio.RecordMic]}" IsChecked="{Binding SettingsEdit.Audio.MicrophoneEnabled}"/>
          <TextBlock Text="{Binding Loc[Audio.Mic]}" Margin="0,13,0,9"/><ComboBox ItemsSource="{Binding MicrophoneSelection.Options}" DisplayMemberPath="Name" SelectedValuePath="Id" IsSynchronizedWithCurrentItem="False" SelectedValue="{Binding MicrophoneSelection.SelectedId, Mode=TwoWay}"/>
          <Grid Margin="0,24,0,0"><TextBlock Text="{Binding Loc[Audio.MicGain]}"/><TextBlock Text="{Binding Value, ElementName=MicGain, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}"/></Grid><Slider x:Name="MicGain" Minimum="0" Maximum="100" Value="{Binding SettingsEdit.Audio.MicrophoneVolume}"/>
          <TextBlock Text="{Binding Loc[Audio.Tracks]}" Margin="0,18,0,9"/><ComboBox ItemsSource="{Binding AudioModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SettingsEdit.Audio.Mode}"/>
          <TextBlock Text="{Binding Loc[Audio.TracksHint]}" Style="{DynamicResource MutedText}" Margin="0,12,0,0"/>
        </StackPanel></Border>
        <Border Style="{DynamicResource Card}" Margin="0,16,0,0"><TextBlock Text="{Binding Loc[Audio.CardBottom]}" Style="{DynamicResource MutedText}"/></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{Binding Loc[Settings.TabReplay]}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
        <TextBlock Text="{Binding Loc[Replay.Title]}" Style="{DynamicResource SectionTitle}"/><TextBlock Text="{Binding Loc[Replay.Subtitle]}" Style="{DynamicResource MutedText}" Margin="0,0,0,22"/>
        <Border Style="{DynamicResource Card}"><StackPanel>
          <Grid><TextBlock Text="{Binding Loc[Replay.BufferLength]}"/><TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Accent}"><Run Text="{Binding Value, ElementName=BufferLength, StringFormat={}{0:F0}, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Loc[Unit.Seconds], Mode=OneWay}"/></TextBlock></Grid><Slider x:Name="BufferLength" Minimum="15" Maximum="300" TickFrequency="5" Value="{Binding SettingsEdit.Replay.BufferSeconds}"/>
          <TextBlock Text="{Binding Loc[Replay.BufferHint]}" Style="{DynamicResource MutedText}" Margin="0,2,0,22"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Loc[Replay.PostRoll]}" Margin="0,0,0,9"/><TextBox Text="{Binding SettingsEdit.Replay.PostEventSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding Loc[Replay.PreRoll]}" Margin="0,0,0,9"/><TextBox Text="{Binding SettingsEdit.Replay.PreEventSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel></Grid>
          <Border Height="1" Background="{DynamicResource Border}" Margin="0,24,0,16"/>
          <CheckBox Content="{Binding Loc[Replay.CoalesceCheck]}" IsChecked="{Binding SettingsEdit.Replay.Coalesce}"/>
          <TextBlock Text="{Binding Loc[Replay.CoalesceHint]}" Style="{DynamicResource MutedText}" Margin="0,3,0,17"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Loc[Replay.CoalesceGap]}" Margin="0,0,0,9"/><TextBox Text="{Binding SettingsEdit.Replay.CoalesceGapSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding Loc[Replay.MaxSequence]}" Margin="0,0,0,9"/><TextBox Text="{Binding SettingsEdit.Replay.MaxSequenceSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel></Grid>
          <Border Height="1" Background="{DynamicResource Border}" Margin="0,24,0,17"/>
          <TextBlock Text="{Binding Loc[Replay.GameEvents]}" Style="{DynamicResource Eyebrow}" Margin="0,0,0,9"/>
          <CheckBox Content="{Binding Loc[Replay.HunterKilled]}" IsChecked="{Binding SettingsEdit.Replay.HunterKilled}"/>
          <CheckBox Content="{Binding Loc[Replay.PlayerDowned]}" IsChecked="{Binding SettingsEdit.Replay.PlayerDowned}"/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{Binding Loc[Settings.TabStorage]}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
        <TextBlock Text="{Binding Loc[Storage.Title]}" Style="{DynamicResource SectionTitle}"/><TextBlock Text="{Binding Loc[Storage.Subtitle]}" Style="{DynamicResource MutedText}" Margin="0,0,0,22"/>
        <Border Style="{DynamicResource Card}"><StackPanel><TextBlock Text="{Binding Loc[Storage.SaveDir]}" Margin="0,0,0,9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SettingsEdit.Storage.Directory, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="{Binding Loc[Storage.Browse]}" Command="{Binding BrowseCommand}" Margin="10,0,0,0"/></Grid>
          <TextBlock Text="{Binding Loc[Storage.DirHint]}" Style="{DynamicResource MutedText}" Margin="0,9,0,0"/>
          <TextBlock Text="{Binding Loc[Storage.Template]}" Margin="0,24,0,9"/><TextBox Text="{Binding SettingsEdit.Storage.FileNameTemplate, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
          <TextBlock Text="{Binding Loc[Storage.TemplateHint]}" Style="{DynamicResource MutedText}" Margin="0,12,0,24"/>
          <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,16"/>
          <CheckBox Content="{Binding Loc[Storage.AutoCleanup]}" IsChecked="{Binding SettingsEdit.Storage.AutoCleanup}"/>
          <TextBlock Text="{Binding Loc[Storage.DiskLimit]}" Margin="0,13,0,9"/><ComboBox ItemsSource="{Binding DiskLimits}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SettingsEdit.Storage.LimitGb}" Width="230" HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding Loc[Storage.CleanupHint]}" Style="{DynamicResource MutedText}" Margin="0,15,0,0"/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{Binding Loc[Settings.TabSystem]}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
        <TextBlock Text="{Binding Loc[System.Title]}" Style="{DynamicResource SectionTitle}"/><TextBlock Text="{Binding Loc[System.Subtitle]}" Style="{DynamicResource MutedText}" Margin="0,0,0,22"/>
        <Border Style="{DynamicResource Card}"><StackPanel>
          <TextBlock Text="{Binding Loc[System.HotkeySection]}" Style="{DynamicResource Eyebrow}" Margin="0,0,0,16"/>
          <TextBlock Text="{Binding Loc[System.ManualHotkey]}" Margin="0,0,0,9"/><ComboBox ItemsSource="{Binding Hotkeys}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SettingsEdit.System.HotkeyVirtualKey}" Width="170" HorizontalAlignment="Left"/>
          <CheckBox Content="{Binding Loc[System.SoundOnSave]}" IsChecked="{Binding SettingsEdit.System.SoundOnSave}" Margin="0,14,0,0"/>
          <Border Height="1" Background="{DynamicResource Border}" Margin="0,24,0,17"/>
          <TextBlock Text="{Binding Loc[System.AutomationSection]}" Style="{DynamicResource Eyebrow}" Margin="0,0,0,9"/>
          <CheckBox Content="{Binding Loc[System.StartWithWindows]}" IsChecked="{Binding SettingsEdit.System.StartWithWindows}"/>
          <CheckBox Content="{Binding Loc[System.AutoBuffer]}" IsChecked="{Binding SettingsEdit.System.AutoBufferWithGame}"/>
          <CheckBox Content="{Binding Loc[System.CloseToTray]}" IsChecked="{Binding SettingsEdit.System.CloseToTray}"/>
          <TextBlock Text="{Binding Loc[System.TrayHint]}" Style="{DynamicResource MutedText}" Margin="0,6,0,0"/>
        </StackPanel></Border>
        <Border Style="{DynamicResource Card}" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Loc[System.DiagnosticsCardTitle]}" FontWeight="SemiBold"/><TextBlock Text="{Binding Loc[System.DiagnosticsCardDesc]}" Style="{DynamicResource MutedText}" Margin="0,6,12,0"/></StackPanel><Button Grid.Column="1" Content="{Binding Loc[System.CheckSystemButton]}" Command="{Binding DiagnoseCommand}" VerticalAlignment="Center"/></Grid></Border>
        <Border Style="{DynamicResource Card}" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Loc[System.UpdatesCardTitle]}" FontWeight="SemiBold"/><TextBlock Text="{Binding UpdateStatusLabel}" Style="{DynamicResource MutedText}" Margin="0,6,12,0"/></StackPanel><Button Grid.Column="1" Content="{Binding Loc[System.CheckUpdatesButton]}" Command="{Binding CheckUpdateCommand}" VerticalAlignment="Center"/></Grid></Border>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
