<UserControl x:Class="HuntReplay.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,6,0">
      <Border CornerRadius="10" BorderBrush="{DynamicResource HeroBorder}" BorderThickness="1" ClipToBounds="True" Background="{DynamicResource HeroBackground}">
        <Grid MinHeight="225">
          <Canvas HorizontalAlignment="Right" Width="335" Opacity="0.48" ClipToBounds="True">
            <Path Data="M-20,216 C70,80 130,220 280,-10 M-20,195 C65,65 120,200 260,-20 M-20,174 C62,43 105,180 240,-30 M-20,153 C52,25 90,155 220,-40 M80,270 C220,180 160,165 350,10 M100,285 C240,195 180,190 370,30 M120,300 C260,210 200,215 390,50" Stroke="{DynamicResource HeroCurves}" StrokeThickness="0.8"/>
            <Ellipse Width="126" Height="126" Stroke="{DynamicResource HeroCurves}" StrokeThickness="1" Canvas.Left="134" Canvas.Top="49"/>
            <Ellipse Width="108" Height="108" Stroke="{DynamicResource HeroCurves}" StrokeThickness="1" Canvas.Left="143" Canvas.Top="58"/>
            <Path Data="M197,26 L197,81 M197,143 L197,198 M111,112 L166,112 M228,112 L283,112 M185,112 L209,112 M197,100 L197,124" Stroke="{DynamicResource HeroAccentText}" StrokeThickness="1"/>
            <TextBlock Text="REC // 1896" Canvas.Left="162" Canvas.Top="205" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource HeroAccentText}"/>
          </Canvas>
          <StackPanel Margin="28,25" MaxWidth="580" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{Binding IsGameConnected, Converter={StaticResource StatusBrush}}" Margin="0,0,9,0"/><TextBlock Text="{Binding GameStatus}" FontSize="11" Foreground="{DynamicResource Accent}"/></StackPanel>
            <TextBlock Text="{Binding Loc[Dash.HeroTitle]}" FontSize="27" FontWeight="SemiBold" LineHeight="35" Margin="0,16,0,11"/>
            <TextBlock Text="{Binding Loc[Dash.HeroDesc]}" Foreground="{DynamicResource Muted}" FontSize="12"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{DynamicResource Card}"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <Grid><TextBlock Text="{Binding Loc[Dash.RingBuffer]}" Style="{DynamicResource Eyebrow}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Width="5" Height="5" Fill="{Binding IsBufferActive, Converter={StaticResource StatusBrush}}" Margin="0,0,7,0"/><TextBlock Text="{Binding BufferStatus}" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel></Grid>
          <Grid Grid.Row="1" Margin="0,12,0,11"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding BufferTime}" FontSize="34" FontFamily="Consolas"/><TextBlock Text="{Binding BufferTarget}" Foreground="{DynamicResource Muted}" FontSize="16" Margin="8,17,0,0"/></StackPanel><TextBlock Text="{Binding MemoryText}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5" Foreground="{DynamicResource Muted}" FontSize="11"/></Grid>
          <ProgressBar Grid.Row="2" Height="3" Value="{Binding BufferFill, Mode=OneWay}" Maximum="100"/>
          <TextBlock Grid.Row="3" Text="{Binding PendingText}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,13,0,0"/>
        </Grid></Border>
        <Border Grid.Column="2" Style="{DynamicResource Card}"><StackPanel><TextBlock Text="{Binding Loc[Dash.RecordingEngine]}" Style="{DynamicResource Eyebrow}"/><TextBlock Text="{Binding GpuStatus}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding GpuStatus}" Margin="0,17,0,9"/><TextBlock Text="{Binding VideoStatus}" Foreground="{DynamicResource Accent}" FontSize="11"/><TextBlock Text="{Binding CaptureDetail}" Style="{DynamicResource MutedText}" FontSize="10" Margin="0,13,0,0"/></StackPanel></Border>
      </Grid>
      <Grid Margin="0,16,0,26"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Style="{DynamicResource PrimaryButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Padding="20,13"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" Margin="0,2,12,0"/><TextBlock Text="{Binding ManualLabel}" Foreground="{DynamicResource Text}" FontWeight="SemiBold"/><Border Background="{DynamicResource AccentDark}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="17,-2,0,-2"><TextBlock Text="{Binding HotkeyLabel}" FontSize="10" Foreground="{DynamicResource Accent}"/></Border></StackPanel></Button>
        <Button Grid.Column="1" Content="{Binding ToggleLabel}" Command="{Binding ToggleBufferCommand}" Padding="18,13"/>
      </Grid>
      <Grid Margin="0,0,0,13"><TextBlock Text="{Binding Loc[Dash.RecentHighlights]}" Style="{DynamicResource SectionTitle}"/><Button Content="{Binding Loc[Dash.AllClips]}" Style="{DynamicResource QuietButton}" Padding="8,0" MinHeight="24" HorizontalAlignment="Right" Command="{Binding SelectRecentCommand}" Click="OpenGallery"/></Grid>
      <Border Style="{DynamicResource Card}" Visibility="{Binding HasClips, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}" Margin="0,0,0,22"><StackPanel HorizontalAlignment="Center" Margin="0,5"><TextBlock Text="{Binding Loc[Dash.NoClipsTitle]}" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding Loc[Dash.NoClipsDesc]}" Style="{DynamicResource MutedText}" Margin="0,7,0,0" TextAlignment="Center"/></StackPanel></Border>
      <ItemsControl ItemsSource="{Binding RecentClips}" Visibility="{Binding HasClips, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,22"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
        <Button Command="{Binding DataContext.SelectRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="0" Margin="0,0,10,0" HorizontalContentAlignment="Stretch"><StackPanel><Grid Height="110" Background="{DynamicResource SurfaceRaised}"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/><Border Background="#C0101619" CornerRadius="3" Padding="6,3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"><TextBlock Text="{Binding Duration}" FontSize="10" Foreground="#F2F5F3"/></Border></Grid><StackPanel Margin="12"><TextBlock Text="{Binding EventLabel}" FontSize="10" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel></StackPanel></Button>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border Style="{DynamicResource Card}" Padding="0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ToggleButton x:Name="SessionLogToggle" IsChecked="True" Cursor="Hand" Focusable="True"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Header" Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="17,0"><Grid><TextBlock Text="{Binding Loc[Dash.SessionLog]}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="Chevron" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="False"><Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/><Setter TargetName="Header" Property="BorderThickness" Value="0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
          <ListBox Grid.Row="1" Height="96" Visibility="{Binding IsChecked, ElementName=SessionLogToggle, Converter={StaticResource BoolVisibility}}" ItemsSource="{Binding Events}" Background="{DynamicResource SurfaceRaised}" BorderThickness="0" Padding="12,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="3,4"/><Setter Property="Focusable" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Timestamp}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding Level}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Accent}"/><TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
