<UserControl x:Class="HuntReplay.App.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Loc[Diag.Title]}" Style="{DynamicResource SectionTitle}"/><TextBlock Text="{Binding Loc[Diag.Subtitle]}" Style="{DynamicResource MutedText}" Margin="0,0,0,22"/>
      <WrapPanel Margin="0,0,0,19"><Button Content="{Binding Loc[Diag.CheckReadiness]}" Command="{Binding DiagnoseCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,10"/><Button Content="{Binding Loc[Diag.SaveReport]}" Command="{Binding SaveReportCommand}" Margin="0,0,10,10"/><Button Content="{Binding Loc[Diag.OpenLogs]}" Command="{Binding OpenLogsCommand}" Margin="0,0,0,10"/></WrapPanel>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Style="{DynamicResource Card}" Margin="0,19,0,0"><StackPanel><TextBlock Text="{Binding Loc[Diag.NvidiaRegistration]}" FontWeight="SemiBold"/><TextBlock Text="{Binding Loc[Diag.NvidiaDesc]}" Style="{DynamicResource MutedText}" Margin="0,9,0,15"/><WrapPanel><Button Content="{Binding Loc[Diag.InstallShim]}" Command="{Binding InstallCommand}" Margin="0,0,10,0"/><Button Content="{Binding Loc[Diag.RestoreRegistry]}" Command="{Binding UninstallCommand}" Style="{DynamicResource QuietButton}"/></WrapPanel></StackPanel></Border>
    <TextBox Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="22" Background="{DynamicResource SurfaceRaised}" Foreground="{DynamicResource Text}"/>
  </DockPanel>
</UserControl>
