<UserControl x:Class="HuntReplay.App.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="Прозрачность вместо обещаний" Style="{StaticResource SectionTitle}"/><TextBlock Text="Проверка работает локально. Никакой телеметрии, загрузки DLL при запуске или скрытого перехода на CPU." Style="{StaticResource MutedText}" Margin="0,0,0,22"/>
      <WrapPanel Margin="0,0,0,19"><Button Content="Проверить готовность системы" Command="{Binding DiagnoseCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"/><Button Content="Сохранить отчёт" Command="{Binding SaveReportCommand}" Margin="0,0,10,10"/><Button Content="Открыть журнал" Command="{Binding OpenLogsCommand}" Margin="0,0,0,10"/></WrapPanel>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,19,0,0"><StackPanel><TextBlock Text="Регистрация NVIDIA Highlights" FontWeight="SemiBold"/><TextBlock Text="Установка проверяет подпись MessageBus.dll и сохраняет предыдущие значения реестра. Восстановление не удаляет чужие ветки NVIDIA или ваши клипы." Style="{StaticResource MutedText}" Margin="0,9,0,15"/><WrapPanel><Button Content="Установить / исправить  ↗ UAC" Command="{Binding InstallCommand}" Margin="0,0,10,0"/><Button Content="Восстановить реестр  ↗ UAC" Command="{Binding UninstallCommand}" Style="{StaticResource QuietButton}"/></WrapPanel></StackPanel></Border>
    <TextBox Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="22" Background="#0D1417"/>
  </DockPanel>
</UserControl>
