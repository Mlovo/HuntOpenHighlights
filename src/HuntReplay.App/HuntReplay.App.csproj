<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>HuntReplayStudio</AssemblyName>
    <RootNamespace>HuntReplay.App</RootNamespace>
    <Version>0.1.9</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Studio.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <ProjectReference Include="../HuntReplay.Core/HuntReplay.Core.csproj" />
    <ProjectReference Include="../HuntReplay.Protocol/HuntReplay.Protocol.csproj" />
    <EmbeddedResource Include="../../bin/MessageBus.dll" LogicalName="HuntReplay.Payload.MessageBus.dll" />
    <EmbeddedResource Include="Assets/Studio.ico" LogicalName="HuntReplay.Studio.ico" />
    <EmbeddedResource Include="../../artifacts/runtime/*.dll" LogicalName="HuntReplay.Native.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../artifacts/runtime/native.sha256" LogicalName="HuntReplay.Native.manifest" Condition="Exists('../../artifacts/runtime/native.sha256')" />
  </ItemGroup>
  <Target Name="RequireNativePayload" BeforeTargets="PrepareForPublish" Condition="'$(SkipNativePayloadCheck)' != 'true'">
    <Error Condition="!Exists('../../artifacts/runtime/HuntReplay.Media.dll')" Text="Native runtime missing. Run tools/Build.ps1 on Windows before publishing." />
    <Error Condition="!Exists('../../artifacts/runtime/native.sha256')" Text="Native manifest missing. Run tools/Build.ps1." />
  </Target>
</Project>
